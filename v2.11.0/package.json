{
  "name": "android-layout-editor",
  "displayName": "Android XML Layout Editor",
  "description": "Visual editor for Android XML layouts with drag-and-drop design, XML validation, attribute completion, resource drag-drop, layout bounds visualization, device preview, Layout Inspector, code snippets & templates, export to image, and accessibility checker",
  "version": "2.11.0",
  "publisher": "cheng-x01",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Visualization",
    "Debuggers",
    "Other"
  ],
  "keywords": [
    "android",
    "xml",
    "layout",
    "editor",
    "visual",
    "drag-drop",
    "inspector",
    "validation",
    "snippets",
    "templates",
    "accessibility",
    "export"
  ],
  "activationEvents": [
    "onLanguage:xml",
    "onCommand:androidLayoutEditor.open",
    "onCommand:androidLayoutEditor.openSidebar",
    "onCommand:androidLayoutEditor.newLayout",
    "onCommand:androidLayoutEditor.toggleBounds",
    "onCommand:androidLayoutEditor.showInspector",
    "onCommand:androidLayoutEditor.openCode",
    "onCommand:androidLayoutEditor.exportImage",
    "onCustomEditor:androidLayoutEditor.layoutEditor"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "androidLayoutEditor.open",
        "title": "Open in Layout Editor",
        "category": "Android Layout Editor",
        "icon": "$(layout)"
      },
      {
        "command": "androidLayoutEditor.openSidebar",
        "title": "Open Layout Editor Panel",
        "category": "Android Layout Editor",
        "icon": "$(layout-panel)"
      },
      {
        "command": "androidLayoutEditor.newLayout",
        "title": "New Android Layout",
        "category": "Android Layout Editor",
        "icon": "$(new-file)"
      },
      {
        "command": "androidLayoutEditor.toggleBounds",
        "title": "Toggle Layout Bounds",
        "category": "Android Layout Editor",
        "icon": "$(debug-breakpoint-conditional-unverified)"
      },
      {
        "command": "androidLayoutEditor.showInspector",
        "title": "Show Layout Inspector",
        "category": "Android Layout Editor",
        "icon": "$(inspect)"
      },
      {
        "command": "androidLayoutEditor.openCode",
        "title": "Open XML in Code Editor",
        "category": "Android Layout Editor",
        "icon": "$(go-to-file)"
      },
      {
        "command": "androidLayoutEditor.exportImage",
        "title": "Export Layout as Image",
        "category": "Android Layout Editor",
        "icon": "$(camera)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "androidLayoutEditor.open",
          "when": "resourceExtname == .xml",
          "group": "2_workspace@5"
        },
        {
          "command": "androidLayoutEditor.newLayout",
          "group": "2_workspace@6"
        }
      ],
      "editor/title": [
        {
          "command": "androidLayoutEditor.open",
          "when": "resourceExtname == .xml && activeEditor !~ androidLayoutEditor.layoutEditor",
          "group": "navigation"
        },
        {
          "command": "androidLayoutEditor.openCode",
          "when": "activeEditor == androidLayoutEditor.layoutEditor",
          "group": "navigation"
        },
        {
          "command": "androidLayoutEditor.toggleBounds",
          "when": "activeEditor == androidLayoutEditor.layoutEditor",
          "group": "navigation"
        },
        {
          "command": "androidLayoutEditor.showInspector",
          "when": "activeEditor == androidLayoutEditor.layoutEditor",
          "group": "navigation"
        },
        {
          "command": "androidLayoutEditor.exportImage",
          "when": "activeEditor == androidLayoutEditor.layoutEditor",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "androidLayoutEditor.open",
          "when": "resourceExtname == .xml"
        },
        {
          "command": "androidLayoutEditor.openSidebar"
        },
        {
          "command": "androidLayoutEditor.newLayout"
        },
        {
          "command": "androidLayoutEditor.toggleBounds",
          "when": "activeEditor == androidLayoutEditor.layoutEditor"
        },
        {
          "command": "androidLayoutEditor.showInspector",
          "when": "activeEditor == androidLayoutEditor.layoutEditor"
        },
        {
          "command": "androidLayoutEditor.openCode",
          "when": "activeEditor == androidLayoutEditor.layoutEditor"
        },
        {
          "command": "androidLayoutEditor.exportImage",
          "when": "activeEditor == androidLayoutEditor.layoutEditor"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "androidLayoutEditor.layoutEditor",
        "displayName": "Android Layout Editor",
        "selector": [
          {
            "filenamePattern": "*.xml"
          }
        ],
        "priority": "option"
      }
    ],
    "configuration": {
      "title": "Android Layout Editor",
      "properties": {
        "androidLayoutEditor.theme": {
          "type": "string",
          "default": "dark",
          "enum": ["dark", "light"],
          "description": "Editor theme (dark or light)",
          "order": 1
        },
        "androidLayoutEditor.autoSave": {
          "type": "boolean",
          "default": true,
          "description": "Auto save changes to XML file",
          "order": 2
        },
        "androidLayoutEditor.phoneRatio": {
          "type": "string",
          "default": "9-16",
          "enum": ["9-16", "3-4", "1-2"],
          "description": "Default phone aspect ratio",
          "order": 3
        },
        "androidLayoutEditor.showBounds": {
          "type": "boolean",
          "default": false,
          "description": "Show layout bounds (margin, padding, constraints)",
          "order": 4
        },
        "androidLayoutEditor.devicePreset": {
          "type": "string",
          "default": "pixel-7",
          "enum": ["pixel-7", "pixel-7a", "galaxy-s23", "galaxy-s23-ultra", "iphone-15", "ipad-air", "small-phone", "tablet-10"],
          "description": "Default device preset for preview",
          "order": 5
        },
        "androidLayoutEditor.density": {
          "type": "string",
          "default": "xxhdpi",
          "enum": ["ldpi", "mdpi", "hdpi", "xhdpi", "xxhdpi", "xxxhdpi"],
          "description": "Default screen density for preview",
          "order": 6
        },
        "androidLayoutEditor.appTheme": {
          "type": "string",
          "default": "light",
          "enum": ["light", "dark", "material_you"],
          "description": "Android app theme for preview (Light/Dark/Material You)",
          "order": 7
        }
      }
    },
    "keybindings": [
      {
        "command": "androidLayoutEditor.toggleBounds",
        "key": "ctrl+shift+x",
        "mac": "cmd+shift+x",
        "when": "activeEditor == androidLayoutEditor.layoutEditor",
        "title": "Toggle Layout Bounds"
      },
      {
        "command": "androidLayoutEditor.showInspector",
        "key": "ctrl+shift+i",
        "mac": "cmd+shift+i",
        "when": "activeEditor == androidLayoutEditor.layoutEditor",
        "title": "Toggle Layout Inspector"
      }
    ]
  },
  "scripts": {
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "vsce": "^2.15.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cheng-X01/android-layout-editor"
  },
  "license": "MIT"
}