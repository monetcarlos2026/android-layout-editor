{
  "name": "android-layout-editor",
  "displayName": "Android XML Layout Editor",
  "description": "Visual editor for Android XML layouts with drag-and-drop design, XML validation, lint, multi-file navigation, Material 3 theme, multi-screen preview, formatting, refactoring, performance analysis, and resource management",
  "version": "2.13.0",
  "publisher": "cheng-x01",
  "engines": { "vscode": "^1.74.0" },
  "categories": ["Visualization", "Debuggers", "Other"],
  "keywords": ["android", "xml", "layout", "editor", "visual", "drag-drop", "inspector", "validation", "lint", "navigation", "material3", "multi-screen", "snippets", "templates", "accessibility", "export", "formatting", "refactoring", "performance", "overdraw", "resources"],
  "activationEvents": ["onLanguage:xml", "onCommand:androidLayoutEditor.open", "onCommand:androidLayoutEditor.openSidebar", "onCommand:androidLayoutEditor.newLayout", "onCommand:androidLayoutEditor.toggleBounds", "onCommand:androidLayoutEditor.showInspector", "onCommand:androidLayoutEditor.openCode", "onCommand:androidLayoutEditor.exportImage", "onCommand:androidLayoutEditor.formatDocument", "onCommand:androidLayoutEditor.extractToString", "onCommand:androidLayoutEditor.extractToDimen", "onCommand:androidLayoutEditor.wrapWithLayout", "onCommand:androidLayoutEditor.unwrapLayout", "onCommand:androidLayoutEditor.showPerformancePanel", "onCustomEditor:androidLayoutEditor.layoutEditor"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {"command": "androidLayoutEditor.open", "title": "Open in Layout Editor", "category": "Android Layout Editor", "icon": "$(layout)"},
      {"command": "androidLayoutEditor.openSidebar", "title": "Open Layout Editor Panel", "category": "Android Layout Editor", "icon": "$(layout-panel)"},
      {"command": "androidLayoutEditor.newLayout", "title": "New Android Layout", "category": "Android Layout Editor", "icon": "$(new-file)"},
      {"command": "androidLayoutEditor.toggleBounds", "title": "Toggle Layout Bounds", "category": "Android Layout Editor", "icon": "$(debug-breakpoint-conditional-unverified)"},
      {"command": "androidLayoutEditor.showInspector", "title": "Show Layout Inspector", "category": "Android Layout Editor", "icon": "$(inspect)"},
      {"command": "androidLayoutEditor.openCode", "title": "Open XML in Code Editor", "category": "Android Layout Editor", "icon": "$(go-to-file)"},
      {"command": "androidLayoutEditor.exportImage", "title": "Export Layout as Image", "category": "Android Layout Editor", "icon": "$(camera)"},
      {"command": "androidLayoutEditor.formatDocument", "title": "Format XML Layout", "category": "Android Layout Editor"},
      {"command": "androidLayoutEditor.extractToString", "title": "Extract to @string", "category": "Android Layout Editor"},
      {"command": "androidLayoutEditor.extractToDimen", "title": "Extract to @dimen", "category": "Android Layout Editor"},
      {"command": "androidLayoutEditor.wrapWithLayout", "title": "Wrap with Layout", "category": "Android Layout Editor"},
      {"command": "androidLayoutEditor.unwrapLayout", "title": "Unwrap Layout", "category": "Android Layout Editor"},
      {"command": "androidLayoutEditor.showPerformancePanel", "title": "Show Performance Analysis", "category": "Android Layout Editor"}
    ],
    "menus": {
      "explorer/context": [
        {"command": "androidLayoutEditor.open", "when": "resourceExtname == .xml", "group": "2_workspace@5"},
        {"command": "androidLayoutEditor.newLayout", "group": "2_workspace@6"}
      ],
      "editor/title": [
        {"command": "androidLayoutEditor.open", "when": "resourceExtname == .xml && activeEditor !~ androidLayoutEditor.layoutEditor", "group": "navigation"},
        {"command": "androidLayoutEditor.openCode", "when": "activeEditor == androidLayoutEditor.layoutEditor", "group": "navigation"},
        {"command": "androidLayoutEditor.toggleBounds", "when": "activeEditor == androidLayoutEditor.layoutEditor", "group": "navigation"},
        {"command": "androidLayoutEditor.showInspector", "when": "activeEditor == androidLayoutEditor.layoutEditor", "group": "navigation"},
        {"command": "androidLayoutEditor.exportImage", "when": "activeEditor == androidLayoutEditor.layoutEditor", "group": "navigation"}
      ]
    },
    "customEditors": [{
      "viewType": "androidLayoutEditor.layoutEditor",
      "displayName": "Android Layout Editor",
      "selector": [{"filenamePattern": "*.xml"}],
      "priority": "option"
    }],
    "configuration": {
      "title": "Android Layout Editor",
      "properties": {
        "androidLayoutEditor.theme": {"type": "string", "default": "dark", "enum": ["dark", "light"], "description": "Editor theme", "order": 1},
        "androidLayoutEditor.autoSave": {"type": "boolean", "default": true, "description": "Auto save changes", "order": 2},
        "androidLayoutEditor.showBounds": {"type": "boolean", "default": false, "description": "Show layout bounds", "order": 3},
        "androidLayoutEditor.devicePreset": {"type": "string", "default": "pixel-7", "enum": ["pixel-7", "pixel-7a", "galaxy-s23", "galaxy-s23-ultra", "iphone-15", "ipad-air", "small-phone", "tablet-10"], "description": "Default device preset", "order": 4},
        "androidLayoutEditor.density": {"type": "string", "default": "xxhdpi", "enum": ["ldpi", "mdpi", "hdpi", "xhdpi", "xxhdpi", "xxxhdpi"], "description": "Screen density", "order": 5},
        "androidLayoutEditor.appTheme": {"type": "string", "default": "light", "enum": ["light", "dark", "material_you"], "description": "App theme for preview", "order": 6},
        "androidLayoutEditor.m3SeedColor": {"type": "string", "default": "#6750A4", "description": "Material 3 seed color", "order": 7},
        "androidLayoutEditor.multiPreview": {"type": "boolean", "default": false, "description": "Show multi-screen preview", "order": 8}
      }
    },
    "keybindings": [
      {"command": "androidLayoutEditor.toggleBounds", "key": "ctrl+shift+x", "mac": "cmd+shift+x", "when": "activeEditor == androidLayoutEditor.layoutEditor"},
      {"command": "androidLayoutEditor.showInspector", "key": "ctrl+shift+i", "mac": "cmd+shift+i", "when": "activeEditor == androidLayoutEditor.layoutEditor"}
    ]
  },
  "scripts": {"package": "vsce package", "publish": "vsce publish"},
  "devDependencies": {"@types/vscode": "^1.74.0", "vsce": "^2.15.0"},
  "repository": {"type": "git", "url": "https://github.com/cheng-X01/android-layout-editor"},
  "license": "MIT"
}